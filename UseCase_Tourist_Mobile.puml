@startuml Tourist_Mobile_UseCase_Chapter4

!theme plain
skinparam actor {
    BackgroundColor LightGreen
    BorderColor Black
}
skinparam usecase {
    BackgroundColor LightYellow
    BorderColor Black
}

title Figure 4.3.2.2 - Use Case Diagram for Tourists (Mobile View)

actor Tourist as tourist

rectangle "Juander Tourism Mobile App - Tourist Mode" {
    
    ' Authentication & Profile
    usecase "Register Account" as UC1
