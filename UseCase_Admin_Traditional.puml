@startuml Administrator_Traditional_UseCase_Chapter4

!theme plain
skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 10
}

title Figure 4.3.2.1 - Use Case Diagram for Administrator (Web Application)

left to right direction

actor Admin

rectangle "Juander - Web View" {
    
    usecase "Login" as login
    usecase "Logout" as logout
    
    usecase "Contents" as contents
    usecase "Roles" as roles
    usecase "Reports" as reports
    usecase "Logs" as logs
    
    ' Contents sub-modules
    usecase "Tour Map" as tourmap
    usecase "Photobooth" as photobooth
    usecase "Emergency Hotlines" as emergency
    usecase "Chatbot" as chatbot
    usecase "Itineraries" as itineraries
    usecase "Reviews" as reviews
    
    ' Extended functionalities with CRUD
    usecase "CRUD Tourist Sites" as sites
    usecase "CRUD Photobooth Filters" as filters
    usecase "CRUD Emergency Hotlines" as contacts
    usecase "CRUD Bot Knowledge" as botdata
    usecase "CRUD Tour Content" as tourcontent
    usecase "Moderate Reviews" as moderate
    usecase "View System Logs" as viewlogs
    usecase "Generate Reports" as genreports
    usecase "Manage Admin Roles" as adminroles
}

' Main relationships
Admin --> login
Admin --> contents
Admin --> roles
Admin --> reports
Admin --> logs

' Contents sub-module relationships
contents ..> tourmap : <<includes>>
contents ..> photobooth : <<includes>>
contents ..> emergency : <<includes>>
contents ..> chatbot : <<includes>>
contents ..> itineraries : <<includes>>
contents ..> reviews : <<includes>>

' Extended functionality relationships
login ..> logout : <<extends>>
tourmap ..> sites : <<includes>>
photobooth ..> filters : <<includes>>
emergency ..> contacts : <<includes>>
chatbot ..> botdata : <<includes>>
itineraries ..> tourcontent : <<includes>>
reviews ..> moderate : <<includes>>
logs ..> viewlogs : <<includes>>
reports ..> genreports : <<includes>>
roles ..> adminroles : <<includes>>

@enduml
