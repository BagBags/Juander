@startuml Tourist_Web_Traditional_UseCase_Chapter4

!theme plain
skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 10
}

title Figure 4.3.2.3 - Use Case Diagram for Tourists (Web Application)

left to right direction

actor Tourist

rectangle "Juander - Web View" {
    
    ' Authentication
    usecase "Login" as login
    usecase "Register" as register
    
    usecase "View Content" as content
    usecase "Chatbot" as chatbot
    
    ' View Content includes (homepage features)
    usecase "Tour Map" as tourmap
    usecase "Manage Profile" as profile
    usecase "Create Itinerary" as createitinerary
    usecase "Trip Archives" as archives
    
    ' Extended functionalities
    usecase "Account" as account
    usecase "Birthday" as birthday
    usecase "Gender" as gender
    usecase "Country" as country
    usecase "Language" as language
    usecase "Settings" as settings
    usecase "Logout" as logout
    usecase "Get Tourism Info" as tourisminfo
    usecase "View/Add/Edit/Delete\nItineraries" as itineraries
    usecase "View/Add/Edit/Delete\nReviews" as reviews
}

' Main relationships
Tourist --> login
Tourist --> content

' Login extends to Register
login ..> register : <<extends>>

' View Content includes (homepage features)
content ..> tourmap : <<includes>>
content ..> profile : <<includes>>
content ..> createitinerary : <<includes>>
content ..> archives : <<includes>>

' Manage Profile includes
profile ..> account : <<includes>>
profile ..> birthday : <<includes>>
profile ..> gender : <<includes>>
profile ..> country : <<includes>>
profile ..> language : <<includes>>
profile ..> settings : <<includes>>
profile ..> logout : <<includes>>

' Extended functionality relationships
tourmap ..> chatbot : <<extends>>
chatbot ..> tourisminfo : <<includes>>
createitinerary ..> itineraries : <<includes>>
archives ..> reviews : <<includes>>

' Login required for authenticated actions
content ..> login : <<requires>>

@enduml
