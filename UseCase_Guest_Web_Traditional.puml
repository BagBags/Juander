@startuml Guest_Web_Traditional_UseCase

!theme plain
skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 10
}

title Figure 4.3.2.2 - Use Case Diagram for Guests (Web Application)

left to right direction

actor Guest

rectangle "Juander - Web View" {
    
    ' Guest Access
    usecase "Continue as Guest" as continueguest
    usecase "Register" as register
    
    usecase "View Content" as content
    usecase "Chatbot" as chatbot
    
    ' View Content includes (homepage features)
    usecase "Tour Map" as tourmap
    usecase "Manage Profile" as profile
    
    ' Limited Profile Management for Guests
    usecase "Create Account" as createaccount
    usecase "Settings" as settings
    usecase "Get Tourism Info" as tourisminfo
}

' Main relationships
Guest --> continueguest
continueguest --> content

' Create Account extends to Register
createaccount ..> register : <<extends>>

' View Content includes (homepage features)
content ..> tourmap : <<includes>>
content ..> profile : <<includes>>
content ..> chatbot : <<includes>>

' Manage Profile includes (limited for guests)
profile ..> createaccount : <<includes>>
profile ..> settings : <<includes>>

' Extended functionality relationships
tourmap ..> chatbot : <<extends>>
chatbot ..> tourisminfo : <<includes>>

' Guest access for viewing content
content ..> continueguest 

@enduml
