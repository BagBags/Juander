@startuml Admin_Contents_Navigation_SSD

actor "Administrator" as Admin
participant "UI: Admin Dashboard" as UI
participant "Authentication" as Auth
participant "Database" as DB

== Admin Login ==

Admin -> UI: Enter credentials
activate UI

UI -> Auth: Validate credentials
activate Auth

Auth -> DB: Check admin credentials
activate DB
DB --> Auth: Return validation result
deactivate DB

Auth --> UI: Authentication successful
deactivate Auth

UI --> Admin: Display Admin Dashboard
deactivate UI

== Access Content Management ==

Admin -> UI: Click "Contents" menu
activate UI

UI -> DB: Get content menu items
activate DB
DB --> UI: Return menu data
deactivate DB

UI --> Admin: Display content management dashboard\n(Tour Map, Photobooth, Emergency Hotlines,\nChatbot, Itineraries, Reviews)
deactivate UI

== Navigate to Specific Management ==

Admin -> UI: Select management option
activate UI

alt Tour Map selected
    UI --> Admin: Redirect to Tour Map Management
else Photobooth selected
    UI --> Admin: Redirect to Photobooth Management
else Emergency Hotlines selected
    UI --> Admin: Redirect to Emergency Hotlines Management
else Chatbot selected
    UI --> Admin: Redirect to Chatbot Management
else Itineraries selected
    UI --> Admin: Redirect to Itineraries Management
else Reviews selected
    UI --> Admin: Redirect to Reviews Management
end

deactivate UI

@enduml
